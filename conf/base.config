/*
 * Configuracao base de recursos por label
 */
process {
    errorStrategy = 'retry'
    maxRetries    = 1

    withLabel: 'process_low' {
        cpus   = 2
        memory = '4.GB'
        time   = '1.h'
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = '8.GB'
        time   = '4.h'
    }
    // maxForks 1: uma unica GPU fisica (gpu_id fixo, params.gpu_id) — com o
    // samplesheet agora tendo varias amostras, o Nextflow tentaria por
    // padrao rodar processos GPU de amostras diferentes em paralelo,
    // disputando o mesmo device. Isso forca a fila a processar uma amostra
    // de cada vez nos estagios de GPU (loop sequencial real).
    withLabel: 'process_gpu' {
        cpus     = 8
        memory   = '16.GB'
        time     = '48.h'
        maxForks = 1
    }
    withLabel: 'process_gpu_long' {
        cpus     = 8
        memory   = '32.GB'
        time     = '120.h'
        maxForks = 1
    }
    // MMGBSA: sem GPU, mas pode ser longo dependendo do nº de frames
    withLabel: 'process_mmgbsa' {
        cpus   = 8
        memory = '16.GB'
        time   = '72.h'
    }
}
